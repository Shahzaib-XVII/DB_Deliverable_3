<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>New Event</title>
</head>
<body>
  <h2><%= mode === 'edit' ? 'Edit Event' : 'Create New Event' %></h2>
  <% if (errors.length) { %>
    <div style="color:red;">
      <ul>
        <% errors.forEach(function(e){ %>
          <li><%= e.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>
   <form method="post" action="<%= formAction %>">
     <label>Title: <input type="text" name="title" value="<%= old.title || '' %>"></label><br>
     <label>Description: <textarea name="description"><%= old.description || '' %></textarea></label><br>
     <label>Venue:
       <select name="venue_id">
         <% venues.forEach(function(v){ %>
           <option value="<%= v.venue_id %>" <%= Number(old.venue_id) === v.venue_id ? 'selected' : '' %>><%= v.name %></option>
         <% }) %>
       </select>
     </label><br>
     <label>Start: <input type="datetime-local" name="start_datetime" value="<%= old.start_datetime || '' %>"></label><br>
     <label>End: <input type="datetime-local" name="end_datetime" value="<%= old.end_datetime || '' %>"></label><br>
     <label>Status:
       <select name="status">
         <% statuses.forEach(function(s){ %>
           <option value="<%= s %>" <%= (old.status || 'DRAFT') === s ? 'selected' : '' %>><%= s %></option>
         <% }) %>
       </select>
     </label><br>
     <label>Created By:
       <select name="created_by">
         <option value="">(none)</option>
         <% users.forEach(function(u){ %>
           <option value="<%= u.user_id %>" <%= Number(old.created_by) === u.user_id ? 'selected' : '' %>><%= u.name %></option>
         <% }) %>
       </select>
     </label><br>
     <button type="submit"><%= submitLabel %></button>
   </form>
   <p><a href="/">Back</a> | <a href="/events">View Events</a></p>
</body>
</html>
