<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Users</title>
</head>
<body>
  <h2>Users</h2>
  <p><a href="/">Home</a> | <a href="/users/new">Add User</a></p>
  <table border="1" cellpadding="6" cellspacing="0">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Role</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function(u){ %>
        <tr>
          <td><%= u.user_id %></td>
          <td><%= u.name %></td>
          <td><%= u.email %></td>
          <td><%= u.phone || '-' %></td>
          <td><%= u.role_name %></td>
          <td>
            <a href="/users/<%= u.user_id %>">View</a> |
            <a href="/users/<%= u.user_id %>/edit">Edit</a> |
            <form method="post" action="/users/<%= u.user_id %>/delete" style="display:inline">
              <button type="submit" aria-label="Delete user <%= u.user_id %>">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
