<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>New User</title>
</head>
<body>
  <h2>Create New User</h2>
  <% if (errors.length) { %>
    <div style="color:red;">
      <ul>
        <% errors.forEach(function(e){ %>
          <li><%= e.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>
  <form method="post" action="/users/new">
    <label>Name: <input type="text" name="name" value="<%= old.name || '' %>"></label><br>
    <label>Email: <input type="email" name="email" value="<%= old.email || '' %>"></label><br>
    <label>Phone: <input type="text" name="phone" value="<%= old.phone || '' %>"></label><br>
    <label>Password (plaintext for demo): <input type="text" name="hashed_password" value="<%= old.hashed_password || '' %>"></label><br>
    <label>Role ID: <input type="number" name="role_id" value="<%= old.role_id || 4 %>"></label><br>
    <button type="submit">Create</button>
  </form>
  <p><a href="/">Back</a></p>
</body>
</html>